<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Allows the Windows head to be built from Linux/macOS CI as well. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>ForamEcoQS.Wpf</RootNamespace>
    <AssemblyName>ForamEcoQS</AssemblyName>
    <Title>ForamEcoQS (Windows)</Title>
    <ApplicationIcon>..\ForamEcoQS.App\Resources\favicon.ico</ApplicationIcon>

    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ForamEcoQS.App\ForamEcoQS.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Eto.Platform.Wpf" Version="2.11.0" />
  </ItemGroup>

</Project>
